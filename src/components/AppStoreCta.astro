---
import { site } from '../site';
---

<div class="app-store-cta">
  {
    site.appStoreUrl ? (
      <a href={site.appStoreUrl}>
        {site.appStoreBadgeSrc ? (
          <img
            src={site.appStoreBadgeSrc}
            alt="Download on the App Store"
            width="120"
            height="40"
          />
        ) : (
          <span>Download on the App Store</span>
        )}
      </a>
    ) : (
      <p class="pending-cta" role="note">
        The official App Store listing is not available yet. When it is
        published, the Apple “Download on the App Store” badge will appear
        here. This is not a download link.
      </p>
    )
  }
</div>
