---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  width,
  height,
  eager = false,
  class: className,
} = Astro.props;
---

<figure class:list={['device-shot', className]}>
  <div class="device-shot__frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>
