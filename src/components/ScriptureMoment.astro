---
interface Props {
  reference: string;
  text?: string | null;
  variant?: 'inline' | 'close';
}

const { reference, text = null, variant = 'inline' } = Astro.props;
---

<figure class:list={['scripture', variant === 'close' && 'scripture--close']}>
  {
    text ? (
      <blockquote class="scripture-text">
        <p>{text}</p>
      </blockquote>
    ) : null
  }
  <figcaption class="scripture-ref">{reference}</figcaption>
</figure>
