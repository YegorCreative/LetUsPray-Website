---
import AppStoreCta from '../components/AppStoreCta.astro';
import BrandMark from '../components/BrandMark.astro';
import DeviceShot from '../components/DeviceShot.astro';
import {
  features,
  homeMeta,
  ipadScreenshots,
  iphoneScreenshots,
  rhythm,
  screenshotIntrinsic,
} from '../content/home';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
---

<BaseLayout
  title={homeMeta.title}
  description={homeMeta.description}
  path="/"
  isHome
>
  <section class="hero band-dark" aria-labelledby="hero-heading">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="hero-brand">
          <BrandMark class="hero-logo" size={96} />
          <span class="hero-wordmark">LetUsPray</span>
        </p>
        <h1 id="hero-heading">Pray through Scripture</h1>
        <p class="hero-lead">
          LetUsPray is a Scripture-centered prayer app. It helps you read God’s
          Word and respond in prayer, one verse at a time.
        </p>
        <p class="hero-support">
          The experience is designed to stay quiet and unhurried, so attention
          can remain on prayer rather than on the app.
        </p>
        <AppStoreCta />
      </div>
      <div class="hero-media">
        <DeviceShot
          src={iphoneScreenshots[0].src}
          alt={iphoneScreenshots[0].alt}
          width={screenshotIntrinsic.width}
          height={screenshotIntrinsic.height}
          eager
        />
      </div>
    </div>
  </section>

  <section class="band band-light" aria-labelledby="what-heading">
    <div class="wrap home-section editorial">
      <h2 id="what-heading">What LetUsPray is</h2>
      <div class="prose">
        <p>LetUsPray helps people pray through Scripture.</p>
        <p>Scripture comes first. Prayer is the response.</p>
        <p>
          The app gives you a peaceful place to open a verse, pray from it, and
          continue a simple journey with God. You can begin without creating an
          account.
        </p>
      </div>
    </div>
  </section>

  <section class="band band-secondary" aria-labelledby="how-heading">
    <div class="wrap home-section">
      <h2 id="how-heading">How it works</h2>
      <p class="lede">Every prayer follows the same rhythm.</p>
      <ol class="rhythm">
        {
          rhythm.map((step, index) => (
            <li class="rhythm-item">
              <h3>
                <span class="step-index" aria-hidden="true">{index + 1}.</span>
                {' '}
                {step.title}
              </h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band band-light" aria-labelledby="features-heading">
    <div class="wrap home-section">
      <h2 id="features-heading">Features</h2>
      <p class="lede">Available now on iPhone and iPad.</p>
      <ul class="feature-grid">
        {
          features.map((feature) => (
            <li class="feature-card">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-dark" aria-labelledby="screenshots-heading">
    <div class="wrap home-section">
      <h2 id="screenshots-heading">Inside the app</h2>
      <div class="shot-panel">
        <ul class="shot-rail" aria-label="iPhone screenshots">
          {
            iphoneScreenshots.map((shot) => (
              <li>
                <DeviceShot
                  src={shot.src}
                  alt={shot.alt}
                  caption={shot.caption}
                  width={screenshotIntrinsic.width}
                  height={screenshotIntrinsic.height}
                />
              </li>
            ))
          }
        </ul>
        {
          ipadScreenshots.length > 0 ? (
            <ul class="shot-rail" aria-label="iPad screenshots">
              {ipadScreenshots.map((shot) => (
                <li>
                  <DeviceShot
                    src={shot.src}
                    alt={shot.alt}
                    caption={shot.caption}
                    width={screenshotIntrinsic.width}
                    height={screenshotIntrinsic.height}
                  />
                </li>
              ))}
            </ul>
          ) : null
        }
      </div>
    </div>
  </section>

  <section class="band band-light" aria-labelledby="who-heading">
    <div class="wrap home-section editorial">
      <h2 id="who-heading">Who it is for</h2>
      <div class="prose">
        <p>LetUsPray is for anyone who wants to pray through Scripture.</p>
        <p>
          It is for lifelong believers and for people opening a Bible for the
          first time. It is for families, pastors, students, and anyone who is
          searching, grieving, hoping, or simply ready to begin.
        </p>
        <p>You are welcome here.</p>
      </div>
    </div>
  </section>

  <section class="band band-dark band-compact" aria-labelledby="cta-heading">
    <div class="wrap close-cta">
      <div class="close-cta-copy">
        <h2 id="cta-heading">Get the app</h2>
        <p class="lede">LetUsPray is for iPhone and iPad.</p>
      </div>
      <div class="store-slot"><AppStoreCta /></div>
    </div>
  </section>

  <section class="band band-dark band-compact help-band" aria-labelledby="help-heading">
    <div class="wrap close-help">
      <div class="close-help-copy">
        <h2 id="help-heading">Help</h2>
        <p class="lede">
          Questions, feedback, and privacy information are here when you need them.
        </p>
      </div>
      <ul class="help-links">
        <li><a href="/support">Support and FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/feedback">Feedback</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
