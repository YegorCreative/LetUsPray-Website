---
import AppStoreCta from '../components/AppStoreCta.astro';
import BrandMark from '../components/BrandMark.astro';
import DeviceShot from '../components/DeviceShot.astro';
import ScriptureMoment from '../components/ScriptureMoment.astro';
import {
  features,
  homeMeta,
  ipadScreenshots,
  iphoneScreenshots,
  rhythm,
  scriptures,
  screenshotIntrinsic,
} from '../content/home';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const featureCore = features.slice(0, 4);
const featureMore = features.slice(4);
const [primaryShot, ...otherShots] = iphoneScreenshots;
---

<BaseLayout
  title={homeMeta.title}
  description={homeMeta.description}
  path="/"
  isHome
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">LETUSPRAY</p>
        <h1 id="hero-heading">
          <span class="hero-line">Pray through Scripture.</span>
          <span class="hero-line">Grow closer to Jesus.</span>
        </h1>
        <p class="hero-lead">
          LetUsPray is a Scripture-centered prayer app designed to help you
          slow down, open God’s Word, and respond in prayer—one verse at a
          time.
        </p>
        <p class="hero-welcome">
          Whether you have followed Jesus for years or are just beginning to
          pray, you are welcome here.
        </p>
        <ScriptureMoment
          reference={scriptures.hero.reference}
          text={scriptures.hero.text}
        />
        <AppStoreCta />
      </div>
      <div class="hero-media">
        <div class="hero-glow" aria-hidden="true"></div>
        <DeviceShot
          src={primaryShot.src}
          alt={primaryShot.alt}
          width={screenshotIntrinsic.width}
          height={screenshotIntrinsic.height}
          eager
        />
      </div>
    </div>
  </section>

  <div class="light-flow">
    <section class="what" aria-labelledby="what-heading">
      <div class="wrap what-panel" data-reveal>
        <h2 id="what-heading">What LetUsPray is</h2>
        <div class="prose">
          <p>LetUsPray helps people pray through Scripture.</p>
          <p class="anchor-line">Scripture comes first. Prayer is the response.</p>
          <p>
            The app gives you a peaceful place to open a verse, pray from it, and
            continue a simple journey with God. You can begin without creating an
            account.
          </p>
        </div>
      </div>
    </section>

    <section class="how" aria-labelledby="how-heading">
      <div class="wrap">
        <div class="section-lead" data-reveal>
          <h2 id="how-heading">How it works</h2>
          <p class="lede">Every prayer follows the same rhythm.</p>
        </div>
        <ol class="rhythm">
          {
            rhythm.map((step, index) => (
              <li class="rhythm-item" data-reveal>
                <h3>
                  <span class="step-index" aria-hidden="true">{index + 1}.</span>
                  {' '}
                  {step.title}
                </h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="features" aria-labelledby="features-heading">
      <div class="wrap">
        <div class="section-lead" data-reveal>
          <h2 id="features-heading">Features</h2>
          <p class="lede">Available now on iPhone and iPad.</p>
        </div>
        <ul class="feature-core">
          {
            featureCore.map((feature) => (
              <li class="feature-item feature-item--core" data-reveal>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ul>
        <ul class="feature-more">
          {
            featureMore.map((feature) => (
              <li class="feature-item" data-reveal>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <section class="showcase" aria-labelledby="screenshots-heading">
    <div class="wrap">
      <h2 id="screenshots-heading" data-reveal>Inside the app</h2>
      <div class="showcase-stage" aria-label="iPhone screenshots">
        <div class="phone phone-side phone-left" data-reveal>
          <DeviceShot
            src={otherShots[0].src}
            alt={otherShots[0].alt}
            caption={otherShots[0].caption}
            width={screenshotIntrinsic.width}
            height={screenshotIntrinsic.height}
          />
        </div>
        <div class="phone phone-primary" data-reveal>
          <DeviceShot
            src={primaryShot.src}
            alt={primaryShot.alt}
            caption={primaryShot.caption}
            width={screenshotIntrinsic.width}
            height={screenshotIntrinsic.height}
          />
        </div>
        <div class="phone phone-side phone-right" data-reveal>
          <DeviceShot
            src={otherShots[1].src}
            alt={otherShots[1].alt}
            caption={otherShots[1].caption}
            width={screenshotIntrinsic.width}
            height={screenshotIntrinsic.height}
          />
        </div>
        <div class="phone phone-rear" data-reveal>
          <DeviceShot
            src={otherShots[2].src}
            alt={otherShots[2].alt}
            caption={otherShots[2].caption}
            width={screenshotIntrinsic.width}
            height={screenshotIntrinsic.height}
          />
        </div>
      </div>
      {
        ipadScreenshots.length > 0 ? (
          <ul class="shot-rail" aria-label="iPad screenshots">
            {ipadScreenshots.map((shot) => (
              <li>
                <DeviceShot
                  src={shot.src}
                  alt={shot.alt}
                  caption={shot.caption}
                  width={screenshotIntrinsic.width}
                  height={screenshotIntrinsic.height}
                />
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </section>

  <section class="who" aria-labelledby="who-heading">
    <div class="wrap who-stage" data-reveal>
      <h2 id="who-heading">Who it is for</h2>
      <div class="prose">
        <p>LetUsPray is for anyone who wants to pray through Scripture.</p>
        <p>
          It is for lifelong believers and for people opening a Bible for the
          first time. It is for families, pastors, students, and anyone who is
          searching, grieving, hoping, or simply ready to begin.
        </p>
        <p class="welcome-line">You are welcome here.</p>
      </div>
    </div>
  </section>

  <div class="close-flow">
    <section class="scripture-close" aria-label={scriptures.close.reference}>
      <div class="wrap" data-reveal>
        <ScriptureMoment
          variant="close"
          reference={scriptures.close.reference}
          text={scriptures.close.text}
        />
      </div>
    </section>

    <section class="get-app" aria-labelledby="cta-heading">
      <div class="wrap get-app-panel" data-reveal>
        <BrandMark class="get-app-mark" size={56} />
        <div class="close-cta-copy">
          <h2 id="cta-heading">Get the app</h2>
          <p class="lede">LetUsPray is for iPhone and iPad.</p>
        </div>
        <div class="store-slot"><AppStoreCta /></div>
      </div>
    </section>

    <section class="help-band" aria-labelledby="help-heading">
      <div class="wrap close-help" data-reveal>
        <div class="close-help-copy">
          <h2 id="help-heading">Help</h2>
          <p class="lede">
            Questions, feedback, and privacy information are here when you need them.
          </p>
        </div>
        <ul class="help-links">
          <li><a href="/support">Support and FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/feedback">Feedback</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script src="../scripts/home-experience.js"></script>
