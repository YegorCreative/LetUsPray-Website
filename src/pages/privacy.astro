---
import Placeholder from '../components/Placeholder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy" path="/privacy">
  <article class="section content">
    <h1>Privacy Policy</h1>
    <div class="notice" role="status">
      <p>
        Final Privacy Policy copy is not approved. This page exists so the
        public URL can stay stable. Do not treat the placeholder below as a
        privacy statement.
      </p>
    </div>
    <Placeholder
      title="Owner-approved Privacy Policy text is pending."
      detail="Copy will be written from verified iOS Version 1 implementation facts: local data, optional sync, authentication, third-party processors, retention, and deletion. Do not invent privacy, security, or data-handling claims."
    />
  </article>
</BaseLayout>
